{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    // Playwright bundles the specs; page.evaluate callbacks run in the browser (DOM types).
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom"],
    "noEmit": true
  },
  "include": ["./**/*"]
}
