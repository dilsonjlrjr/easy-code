{
  "name": "easy-code-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:docker": "sh ./scripts/e2e-in-docker.sh",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "build-installer": "vite build --mode installer"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@mdi/js": "7.4.47",
    "@vueuse/core": "15.0.0",
    "dompurify": "3.4.18",
    "markdown-it": "14.1.0",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-i18n": "11.4.23",
    "vue-router": "5.5.1",
    "vuetify": "3.13.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tsconfig/node24": "24.0.6",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-vue": "10.12.1",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "jiti": "2.7.0",
    "jsdom": "31.0.1",
    "npm-run-all2": "9.1.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
